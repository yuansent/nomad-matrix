---
import Layout from '../../layouts/Layout.astro';
import countries from '../../data/countries.json';

const portugal = countries.find((c) => c.id === 'portugal');
const spain = countries.find((c) => c.id === 'spain');
const greece = countries.find((c) => c.id === 'greece');

const pageTitle = 'Portugal vs Spain vs Greece: Which Digital Nomad Visa Fits You in 2026?';
const pageDesc = 'Portugal D8 vs Spain Digital Nomad Visa vs Greece DNV compared on income requirements, taxes, fees, processing times and living costs — and who each country fits.';

const compareSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDesc,
  "mainEntity": {
    "@type": "Article",
    "headline": pageTitle,
    "about": [
      { "@type": "Place", "name": "Portugal" },
      { "@type": "Place", "name": "Spain" },
      { "@type": "Place", "name": "Greece" }
    ]
  }
};
---

<Layout title={pageTitle} description={pageDesc} schema={compareSchema}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex text-xs text-slate-500 mb-6 space-x-2">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <a href="/#compare-section" class="hover:text-blue-600">Compare</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Portugal vs Spain vs Greece</span>
    </nav>

    <!-- Header Box -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center space-x-3 text-4xl mb-4">
        <span>{portugal.flag}</span>
        <span class="text-2xl font-black text-slate-400">VS</span>
        <span>{spain.flag}</span>
        <span class="text-2xl font-black text-slate-400">VS</span>
        <span>{greece.flag}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Portugal vs Spain vs Greece: Which Digital Nomad Visa Fits You in 2026?
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-3">
        Portugal, Spain, and Greece run the three most-searched digital nomad visas in Europe — same Schengen access, same 12-month starting point, very different trade-offs. The cheapest headline income isn't the cheapest year, and the lowest tax rate isn't the lowest tax bill. Here's the comparison on the numbers that actually decide it, then who each country fits.
      </p>
      <p class="text-xs text-slate-400 mt-3">
        Reference data below was verified against NomadMatrix country pages on 2026-11-24. Visa rules change — confirm current requirements with the official authority before applying. This is general reference information, not legal or tax advice.
      </p>
    </div>

    <!-- At a glance: three-way table, numbers rendered from src/data/countries.json -->
    <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm mb-12">
      <div class="grid grid-cols-4 bg-slate-900 text-white p-4 sm:p-6 text-sm font-bold items-center">
        <div class="text-slate-400 text-xs uppercase tracking-wider">Metrics</div>
        <div class="text-center text-base sm:text-lg">{portugal.flag} {portugal.name}</div>
        <div class="text-center text-base sm:text-lg">{spain.flag} {spain.name}</div>
        <div class="text-center text-base sm:text-lg">{greece.flag} {greece.name}</div>
      </div>

      <div class="divide-y divide-slate-100 text-xs sm:text-sm">
        <!-- Visa Name -->
        <div class="grid grid-cols-4 p-4 items-center">
          <div class="font-semibold text-slate-500">Official Visa Name</div>
          <div class="text-center text-slate-800 font-medium px-2">{portugal.visa_name}</div>
          <div class="text-center text-slate-800 font-medium px-2">{spain.visa_name}</div>
          <div class="text-center text-slate-800 font-medium px-2">{greece.visa_name}</div>
        </div>

        <!-- Min Income -->
        <div class="grid grid-cols-4 p-4 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-500">Min. Monthly Income</div>
          <div class="text-center font-bold text-slate-900 px-2">
            ${portugal.min_monthly_income_usd.toLocaleString()}/mo
            <span class="block text-xs font-normal text-slate-500 mt-1">{portugal.min_monthly_income_local}</span>
          </div>
          <div class="text-center font-bold text-slate-900 px-2">
            ${spain.min_monthly_income_usd.toLocaleString()}/mo
            <span class="block text-xs font-normal text-slate-500 mt-1">{spain.min_monthly_income_local}</span>
          </div>
          <div class="text-center font-bold text-slate-900 px-2">
            ${greece.min_monthly_income_usd.toLocaleString()}/mo
            <span class="block text-xs font-normal text-slate-500 mt-1">{greece.min_monthly_income_local}</span>
          </div>
        </div>

        <!-- Stay Duration -->
        <div class="grid grid-cols-4 p-4 items-center">
          <div class="font-semibold text-slate-500">Initial Stay / Max</div>
          <div class="text-center text-slate-800">{portugal.duration_months} months / up to {portugal.max_stay_years} years</div>
          <div class="text-center text-slate-800">{spain.duration_months} months / up to {spain.max_stay_years} years</div>
          <div class="text-center text-slate-800">{greece.duration_months} months / up to {greece.max_stay_years} years</div>
        </div>

        <!-- Nomad Tax Rate -->
        <div class="grid grid-cols-4 p-4 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-500">Nomad Tax Rate</div>
          <div class="text-center font-bold text-slate-900 px-2">
            {portugal.tax_rate_percent}% <span class="block text-xs font-normal text-slate-500 mt-1">IFICI special regime; NHR replaced</span>
          </div>
          <div class="text-center font-bold text-slate-900 px-2">
            {spain.tax_rate_percent}% <span class="block text-xs font-normal text-slate-500 mt-1">Beckham Law flat, up to €600,000, up to 5 years</span>
          </div>
          <div class="text-center font-bold text-slate-900 px-2">
            {greece.tax_rate_percent}% <span class="block text-xs font-normal text-slate-500 mt-1">50% income-tax deduction for up to 7 years if you transfer tax residence</span>
          </div>
        </div>

        <!-- Government Fee -->
        <div class="grid grid-cols-4 p-4 items-center">
          <div class="font-semibold text-slate-500">Government Fee</div>
          <div class="text-center text-slate-800 font-medium">${portugal.application_fee_usd}</div>
          <div class="text-center text-slate-800 font-medium">${spain.application_fee_usd}</div>
          <div class="text-center text-slate-800 font-medium">${greece.application_fee_usd} <span class="block text-xs text-slate-500 mt-1">+ €1,000 for the 2-year residence permit after entry</span></div>
        </div>

        <!-- Processing -->
        <div class="grid grid-cols-4 p-4 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-500">Processing</div>
          <div class="text-center text-slate-800">{portugal.processing_time_weeks}</div>
          <div class="text-center text-slate-800">{spain.processing_time_weeks}</div>
          <div class="text-center text-slate-800">{greece.processing_time_weeks}</div>
        </div>

        <!-- Avg Living Cost -->
        <div class="grid grid-cols-4 p-4 items-center">
          <div class="font-semibold text-slate-500">Avg Monthly Living Cost</div>
          <div class="text-center font-bold text-slate-800">${portugal.avg_monthly_living_cost_usd} USD</div>
          <div class="text-center font-bold text-slate-800">${spain.avg_monthly_living_cost_usd} USD</div>
          <div class="text-center font-bold text-slate-800">${greece.avg_monthly_living_cost_usd} USD</div>
        </div>

        <!-- Internet Speed -->
        <div class="grid grid-cols-4 p-4 items-center bg-slate-50/50">
          <div class="font-semibold text-slate-500">Fixed Internet Speed</div>
          <div class="text-center text-slate-800 font-medium">{portugal.internet_speed_mbps} Mbps</div>
          <div class="text-center text-slate-800 font-medium">{spain.internet_speed_mbps} Mbps</div>
          <div class="text-center text-slate-800 font-medium">{greece.internet_speed_mbps} Mbps</div>
        </div>

        <!-- Top Cities -->
        <div class="grid grid-cols-4 p-4 items-center">
          <div class="font-semibold text-slate-500">Top Remote-Work Cities</div>
          <div class="text-center text-slate-800">{portugal.top_cities.join(', ')}</div>
          <div class="text-center text-slate-800">{spain.top_cities.join(', ')}</div>
          <div class="text-center text-slate-800">{greece.top_cities.join(', ')}</div>
        </div>
      </div>

      <div class="grid grid-cols-4 p-4 bg-slate-100 border-t border-slate-200 text-center text-xs font-bold">
        <div class="text-slate-500">Detailed Page</div>
        <div>
          <a href="/visa/portugal" class="text-blue-600 hover:underline">Full Portugal Guide →</a>
        </div>
        <div>
          <a href="/visa/spain" class="text-blue-600 hover:underline">Full Spain Guide →</a>
        </div>
        <div>
          <a href="/visa/greece" class="text-blue-600 hover:underline">Full Greece Guide →</a>
        </div>
      </div>
    </div>

    <!-- Editorial: decision analysis -->
    <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm space-y-8 mb-12">
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-3">The income test is not the same test</h2>
        <p class="text-sm text-slate-700 leading-relaxed">
          The headline numbers hide different definitions. Portugal counts <strong>gross</strong> income at 4× minimum wage and wants a bank balance showing roughly 12 months of it (~€44,160+) plus a Portuguese bank account and a 1-year lease before you apply — the highest upfront cash ask of the three. Spain's €2,849 is an annualised figure; consulates in practice ask for €2,442/month, and you need only 3 months of remote-work history. Greece wants <strong>€3,500 net</strong> — after tax in your home country, not gross — and adds 20% for a spouse, so a couple needs €4,200 net. If your income is freelance and lumpy, Spain's 3-month history is the easiest bar to clear; if your income is a stable salary, Portugal's savings proof is the binding constraint, not the monthly figure.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-3">Tax: the rate on the page is not the bill</h2>
        <ul class="space-y-3 text-sm text-slate-700 leading-relaxed list-disc list-inside">
          <li><strong>Spain</strong> is the most predictable: Beckham Law gives a flat 24% for up to 5 years. High earners benefit most — the flat rate caps the bill where progressive rates would climb.</li>
          <li><strong>Portugal</strong> offers 20% under the IFICI regime that replaced NHR, but eligibility is narrower than the old NHR was — it targets specific talent profiles, and everyone else pays progressive rates. Don't budget on 20% until you've confirmed you qualify.</li>
          <li><strong>Greece</strong> lists 22% but the real story is the 50% income-tax deduction for up to 7 years if you transfer tax residence — for a mid-range earner that can beat both rivals on effective rate. The catch is the shorter runway: 3 years max versus 5 in Portugal and Spain.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-3">Speed and friction</h2>
        <p class="text-sm text-slate-700 leading-relaxed">
          Spain is the fastest to a yes (3–6 weeks) and the only one of the three where the process is routinely done through a consulate appointment with a standard document set. Greece is nearly as fast (4–6 weeks) but since Law 5275/2026 (in force 6 February 2026) first applications must be made at a Greek consulate for a Type D visa — applying directly in-country is no longer possible — and the €1,000 residence-permit fee after entry roughly doubles the real government cost. Portugal is the slowest (8–12 weeks) and the most paperwork-heavy: NIF tax number, Portuguese bank account, and a 1-year lease up front.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-3">Who should pick which</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-slate-700">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100">
            <h3 class="font-bold text-slate-900 text-base mb-2">Pick Portugal if</h3>
            <p class="leading-relaxed">your income is comfortably above €3,680/month, you can park ~€44,160 in savings, and you want the longest runway (5 years) with a path to EU residency — and you're willing to wait 8–12 weeks and do the NIF + bank account + lease groundwork first. Best for: established remote employees and founders planning to stay.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100">
            <h3 class="font-bold text-slate-900 text-base mb-2">Pick Spain if</h3>
            <p class="leading-relaxed">you want the fastest approval, the cleanest tax picture, and the biggest city choice — or if your income sits between €2,442 and €3,500 and Portugal's bar is out of reach. The Beckham flat 24% is the best deal of the three for high earners. Best for: first-time visa applicants and higher earners who value certainty.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100">
            <h3 class="font-bold text-slate-900 text-base mb-2">Pick Greece if</h3>
            <p class="leading-relaxed">your priority is the lowest monthly cost ($1,500) and the lowest effective tax via the 50% deduction, and a 3-year horizon is enough. Watch the consulate-first rule and budget the extra €1,000 permit fee. Best for: cost-sensitive nomads and couples who can meet the net-income test.</p>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-3">The honest bottom line</h2>
        <p class="text-sm text-slate-700 leading-relaxed">
          There is no cheapest option — only the cheapest option <strong>for your income shape</strong>. A salaried remote worker on $5,000/month will likely pay least in Greece (deduction) or Spain (flat 24%); a freelancer on $4,000/month with thin savings may only clear Spain's bar at all; a founder planning five years in Europe should pay Portugal's upfront cost for the runway. Run your own numbers on net income, not the headline rate — and check the consulate's current figure before you apply, because the income thresholds reset every January.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-3">Compare the full details</h2>
        <ul class="space-y-2 text-sm">
          <li><a href="/visa/portugal" class="text-blue-600 hover:underline">Portugal D8 Visa — full requirements →</a></li>
          <li><a href="/visa/spain" class="text-blue-600 hover:underline">Spain Digital Nomad Visa — full requirements →</a></li>
          <li><a href="/visa/greece" class="text-blue-600 hover:underline">Greece Digital Nomad Visa — full requirements →</a></li>
        </ul>
      </section>

      <!-- SafetyWing Insurance Affiliate Banner -->
      <div class="border border-blue-100 bg-gradient-to-r from-blue-50/80 via-white to-blue-50/50 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
        <div>
          <span class="text-[10px] font-bold text-blue-600 bg-blue-100 px-2.5 py-1 rounded-full uppercase tracking-wider inline-block mb-2">Essential Requirement</span>
          <h3 class="text-lg font-bold text-slate-900">Health Insurance for Portugal, Spain &amp; Greece Visas</h3>
          <p class="text-xs text-slate-600 mt-1 max-w-xl leading-relaxed">
            All three countries demand official international medical coverage before stamping your digital nomad visa. SafetyWing provides continuous 180+ country nomad coverage with instant downloadable visa confirmation letters.
          </p>
        </div>
        <div class="shrink-0 w-full sm:w-auto text-center">
          <a href="https://safetywing.com/nomad-insurance?referenceID=26636290&utm_source=26636290&utm_medium=Ambassador" target="_blank" rel="noopener sponsored" class="inline-block w-full sm:w-auto px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-sm transition">
            Explore SafetyWing Nomad Policy →
          </a>
          <span class="block text-[10px] text-slate-400 mt-1.5">Starts at ~$45/4 wks • Cancel anytime</span>
        </div>
      </div>
    </div>

    <!-- Visa Change Alerts (Kit) — same form as country pages, ID 10222189 -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-12">
      <p class="font-bold text-slate-900 text-sm mb-1">🔔 Watch these three visas' rules</p>
      <p class="text-xs text-slate-500 mb-3">Currently listed: Portugal $4,090/mo · 12 months · 20% tax; Spain $3,210/mo · 12 months · 24% tax; Greece $3,800/mo · 12 months · 22% tax. Get an email if any of these change — verified against the official source first.</p>
