---
import Layout from '../layouts/Layout.astro';
import countries from '../data/countries.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Global Digital Nomad Visas Database 2026",
  "description": "Comprehensive structured database of digital nomad visas, income thresholds, taxes, Schengen privileges, and duration for 80+ countries.",
  "keywords": ["digital nomad visa", "remote work visa", "no tax countries", "schengen digital nomad", "visa income requirements"],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": {
    "@type": "Organization",
    "name": "NomadMatrix"
  }
};
---

<Layout title="Digital Nomad Visas 2026: Compare Income, Taxes & Requirements" schema={schema}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/60 to-white pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-100/70 border border-blue-200 text-blue-800 text-xs sm:text-sm font-semibold mb-6">
        <span>✨ 100% Free & Open Source of Truth for Remote Relocation</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        Find Your Next Haven: <br />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
          Compare Global Nomad Visas & Taxes
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        No hidden paywalls. Compare minimum monthly income, tax breaks, processing speeds, and stay durations across official immigration programs.
      </p>

      <!-- Quick Metrics Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto">
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-blue-600">{countries.length}+</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Verified Programs</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-emerald-600">0% - 24%</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Tax Regimes</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-purple-600">$0 - $5.5k</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Income Spans</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-amber-600">Weekly</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Laws Verified</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Responsive Ad Slot (Top Placement) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
    <div class="bg-slate-100/80 border border-dashed border-slate-300 rounded-xl py-4 px-6 text-center text-xs text-slate-400">
      <span class="font-semibold uppercase tracking-wider">Advertisement / Sponsored Placement</span>
      <div class="mt-2 text-sm text-slate-700 font-medium">
        🛡️ Working remotely abroad? <a href="https://safetywing.com/nomad-insurance?referenceID=26636290&utm_source=26636290&utm_medium=Ambassador" target="_blank" rel="noopener sponsored" class="text-blue-600 underline font-semibold">SafetyWing Nomad Insurance covers you in 180+ countries for $45/4 weeks →</a>
      </div>
    </div>
  </div>

  <!-- Interactive Visa & Tax Matcher (30-Second Quiz) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-10">
    <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 sm:p-10 text-white shadow-2xl border border-indigo-500/20 relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-3xl mb-8">
        <span class="px-3 py-1 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded-full text-xs font-bold uppercase tracking-wider inline-flex items-center gap-1.5">
          <span>⚡ Interactive Matcher</span>
          <span>•</span>
          <span>30-Second Visa Finder</span>
        </span>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-white mt-3">
          Not Sure Where to Relocate? Find Your Best Match in 3 Seconds
        </h2>
        <p class="text-slate-300 text-xs sm:text-sm mt-2">
          Adjust your monthly remote income, preferred region, and tax appetite. Our engine cross-references 2026 official immigration decrees across 47 jurisdictions in real time.
        </p>
      </div>

      <!-- Controls Form Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 bg-white/5 p-5 rounded-2xl border border-white/10 backdrop-blur-sm">
        <!-- Input 1: Monthly Income -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center justify-between">
            <span>💵 Your Monthly Remote Income</span>
            <span id="income-display" class="text-amber-400 font-mono font-bold">$3,000 / mo</span>
          </label>
          <input 
            type="range" 
            id="quiz-income-range" 
            min="1000" 
            max="6000" 
            step="250" 
            value="3000" 
            class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500 mt-2"
          />
          <div class="flex justify-between text-[10px] text-slate-400 mt-1 font-mono">
            <span>$1k</span>
            <span>$3k</span>
            <span>$6k+</span>
          </div>
        </div>

        <!-- Input 2: Region -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">
            🌍 Target Region
          </label>
          <select id="quiz-region" class="w-full bg-slate-800 text-white text-xs sm:text-sm rounded-xl px-3 py-2.5 border border-slate-700 focus:outline-none focus:border-blue-500 mt-1">
            <option value="all">Any Region (Worldwide)</option>
            <option value="Europe">Europe (Schengen & Non-EU)</option>
            <option value="Latin America">Latin America & Caribbean</option>
            <option value="Asia">Asia & Pacific</option>
            <option value="Middle East">Middle East</option>
          </select>
        </div>

        <!-- Input 3: Tax Appetite -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">
            💰 Tax Appetite
          </label>
          <select id="quiz-tax" class="w-full bg-slate-800 text-white text-xs sm:text-sm rounded-xl px-3 py-2.5 border border-slate-700 focus:outline-none focus:border-blue-500 mt-1">
            <option value="all">Any Tax Rate</option>
            <option value="zero">0% Foreign Income Tax (Havens)</option>
            <option value="low">Under 15% Flat Rate</option>
            <option value="standard">Standard Progressive</option>
          </select>
        </div>
      </div>

      <!-- Live Results Area -->
      <div class="mt-8">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="quiz-match-count" class="text-xs sm:text-sm font-bold text-slate-200">
              Calculating matches...
            </span>
          </div>
          <span class="text-[11px] text-slate-400">Ranked by Eligibility & Cost Efficiency</span>
        </div>

        <!-- Cards Container (Dynamically rendered by JS) -->
        <div id="quiz-results-container" class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Populated by client script -->
        </div>

        <!-- High-Leverage Post-Quiz CTA Box -->
        <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 bg-indigo-950/40 p-4 sm:p-5 rounded-2xl border border-indigo-500/30">
          <div class="text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start space-x-2">
              <span class="text-amber-400 font-bold text-sm">★ Ready to apply for these countries?</span>
            </div>
            <p class="text-xs text-slate-300 mt-1">
              Get the legally verified employer telework letters (.docx), consulate cover letters & 183-day tax tracker.
            </p>
          </div>
          <div class="flex items-center space-x-3 shrink-0">
            <a 
              href="https://2683573618956.gumroad.com/l/byryi" 
              target="_blank" 
              rel="noopener"
              class="px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white text-xs font-bold rounded-xl shadow-lg transition-transform hover:scale-105"
            >
              Get All-In-One Pro Kit ($14.99) →
            </a>
            <a 
              href="https://safetywing.com/nomad-insurance?referenceID=26636290&utm_source=26636290&utm_medium=Ambassador" 
              target="_blank" 
              rel="noopener sponsored"
              class="px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold rounded-xl border border-white/10 transition"
            >
              Health Insurance ($45) ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Directory Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-slate-200">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Active Nomad Visa Programs</h2>
        <p class="text-sm text-slate-500 mt-1">Click any country for complete requirements, checklist, tax details and official application links.</p>
      </div>

      <!-- Quick Filter Tags -->
      <div id="filter-tabs" class="flex flex-wrap gap-2 mt-4 sm:mt-0">
        <button type="button" data-filter="all" class="filter-tab px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-semibold cursor-pointer shadow-sm transition">All ({countries.length})</button>
        <button type="button" data-filter="europe" class="filter-tab px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:border-slate-400 cursor-pointer transition">Europe ({countries.filter(c => c.region === 'Europe').length})</button>
        <button type="button" data-filter="low-income" class="filter-tab px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:border-slate-400 cursor-pointer transition">Low Income (&lt;$3,000)</button>
        <button type="button" data-filter="zero-tax" class="filter-tab px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:border-slate-400 cursor-pointer transition">0% Tax Havens</button>
      </div>
    </div>

    <!-- Cards Grid -->
    <div id="countries-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {countries.map((item) => (
        <a 
          href={`/visa/${item.id}`} 
          class="country-card group bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-xl hover:border-blue-400 transition-all duration-200 flex flex-col justify-between"
          data-region={item.region}
          data-income={item.min_monthly_income_usd}
          data-tax={item.tax_rate_percent}
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center space-x-3">
                <span class="text-3xl">{item.flag}</span>
                <div>
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition flex items-center gap-1.5">
                    {item.name}
                  </h3>
                  <span class="text-xs text-slate-400 font-medium">{item.region}</span>
                </div>
              </div>

              {item.schengen_access && (
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                  🇪🇺 Schengen
                </span>
              )}
            </div>

            <p class="text-xs text-slate-500 mb-5 font-medium line-clamp-1">
              {item.visa_name}
            </p>

            <!-- Metrics Matrix -->
            <div class="grid grid-cols-2 gap-3 py-3 border-y border-slate-100 mb-4 text-xs">
              <div>
                <span class="text-slate-400 block text-[11px]">Min. Income / mo</span>
                <span class="font-extrabold text-slate-900 text-sm">
                  {item.min_monthly_income_usd === 0 ? "Savings Only" : `$${item.min_monthly_income_usd.toLocaleString()}/mo`}
                </span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Stay Duration</span>
                <span class="font-extrabold text-slate-900 text-sm">
                  {item.duration_months} mo ({item.max_stay_years}y max)
                </span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Living Cost (avg)</span>
                <span class="font-semibold text-slate-800">
                  ${item.avg_monthly_living_cost_usd}/mo
                </span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Nomad Tax Rate</span>
                <span class={`font-semibold ${item.tax_rate_percent === 0 ? 'text-emerald-600 font-bold' : 'text-slate-800'}`}>
                  {item.tax_rate_percent}% {item.tax_rate_percent === 0 && '⚡ Zero Tax'}
                </span>
              </div>
            </div>

            <div class="text-xs text-slate-500 space-y-1 mb-4">
              <span class="text-[11px] text-slate-400 font-medium block">Key Hotspots:</span>
              <div class="flex flex-wrap gap-1.5">
                {item.top_cities.map((city) => (
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[11px]">
                    {city}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-600 group-hover:translate-x-1 transition-transform">
            <span>View Full Requirements & Guides</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Side-by-Side Comparison Section (pSEO Powerhouse) -->
  <section id="compare-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl">
      <div class="max-w-3xl mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Head-to-Head Comparisons</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mt-2">
          Compare Visas Side-by-Side
        </h2>
        <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
          Torn between two destinations? See direct parameter-by-parameter matchups of tax rates, income limits, and living costs.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/compare/spain-vs-portugal" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇪🇸 Spain vs 🇵🇹 Portugal</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Europe's top two visas compared: Beckham Law vs NHR replacement.</p>
        </a>

        <a href="/compare/thailand-vs-japan" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇹🇭 Thailand vs 🇯🇵 Japan</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Asia comparison: 5-year DTV visa vs 6-month Japan Nomad visa.</p>
        </a>

        <a href="/compare/croatia-vs-greece" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇭🇷 Croatia vs 🇬🇷 Greece</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Mediterranean lifestyle: 0% Croatian tax vs Greek 50% deduction.</p>
        </a>

        <a href="/compare/costa_rica-vs-mexico" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇨🇷 Costa Rica vs 🇲🇽 Mexico</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Latin America battle: Complete tax exemption vs Temporary Residency.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Pro Kit Monetization Section ($14.99) -->
  <section id="pro-kit" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-white border-2 border-indigo-600/30 rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-indigo-500/10 rounded-full blur-2xl"></div>

      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold uppercase tracking-wider mb-4">
          ★ NomadMatrix Pro Toolkit
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Everything You Need to Apply with Confidence
        </h2>
        <p class="text-slate-600 mt-3 text-base leading-relaxed">
          Skip $2,000 legal consulting fees. Get the exact, battle-tested templates, step-by-step checklists, and interactive tax simulators.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8 text-sm text-slate-700">
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>Remote Employer Attestation Letter</strong> (Apostille-ready lawyer verified template)</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>183-Day Tax Residence Calculator</strong> (Excel & Web interactive simulator)</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>Document Checklist for 25+ Countries</strong> (Translations, Criminal records, Sworn affidavits)</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>Consulate & Embassy Submission Dossier</strong> (Folder structure & file naming guides)</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-baseline sm:items-center space-y-4 sm:space-y-0 sm:space-x-6">
          <div class="flex items-baseline space-x-2">
            <span class="text-4xl font-black text-slate-900">$14.99</span>
            <span class="text-sm text-slate-400 line-through">$49.00</span>
            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">Save 70% Today</span>
          </div>

          <!-- Gumroad Checkout Trigger -->
          <a 
            href="https://2683573618956.gumroad.com/l/byryi" 
            target="_blank"
            class="px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/25 hover:from-blue-700 hover:to-indigo-700 transition hover:scale-[1.02] active:scale-[0.98] text-center"
          >
            Instant Download Nomad Pro Kit →
          </a>
        </div>
        <p class="text-xs text-slate-400 mt-3">🔒 30-day no-questions-asked refund guarantee. Processed via Gumroad (Credit Card / PayPal / Apple Pay).</p>
      </div>
    </div>
  </section>

  <script define:vars={{ countriesData: countries }}>
    function initQuiz() {
      const incomeSlider = document.getElementById('quiz-income-range');
      const incomeDisplay = document.getElementById('income-display');
      const regionSelect = document.getElementById('quiz-region');
      const taxSelect = document.getElementById('quiz-tax');
      const countDisplay = document.getElementById('quiz-match-count');
      const container = document.getElementById('quiz-results-container');

      if (!incomeSlider || !container) return;

      function updateMatcher() {
        const income = parseInt(incomeSlider.value, 10);
        incomeDisplay.textContent = `$${income.toLocaleString()} / mo`;

        const region = regionSelect.value;
        const tax = taxSelect.value;

        const matches = countriesData.filter(c => {
          if (c.min_monthly_income_usd > income) return false;

          if (region !== 'all') {
            if (region === 'Europe' && c.region !== 'Europe') return false;
            if (region === 'Latin America' && !['Latin America', 'Caribbean'].includes(c.region)) return false;
            if (region === 'Asia' && !['Asia', 'Southeast Asia', 'East Asia'].includes(c.region)) return false;
            if (region === 'Middle East' && c.region !== 'Middle East') return false;
          }

          if (tax === 'zero' && c.tax_rate_percent !== 0) return false;
          if (tax === 'low' && c.tax_rate_percent > 15) return false;
          if (tax === 'standard' && c.tax_rate_percent <= 15) return false;

          return true;
        });

        matches.sort((a, b) => {
          if (a.tax_rate_percent !== b.tax_rate_percent) {
            return a.tax_rate_percent - b.tax_rate_percent;
          }
          return a.avg_monthly_living_cost_usd - b.avg_monthly_living_cost_usd;
        });

        countDisplay.textContent = `${matches.length} Jurisdictions Match Your Profile`;

        if (matches.length === 0) {
          container.innerHTML = `
            <div class="col-span-full py-8 text-center bg-white/5 rounded-2xl border border-white/10">
              <p class="text-sm font-semibold text-slate-300">No exact matches under this strict threshold.</p>
              <p class="text-xs text-slate-400 mt-1">Try increasing your monthly income slider or broadening your tax filter.</p>
            </div>
          `;
          return;
        }

        const topThree = matches.slice(0, 3);
        container.innerHTML = topThree.map(item => `
          <div class="bg-white/10 hover:bg-white/15 border border-white/15 hover:border-blue-400/50 rounded-2xl p-5 transition flex flex-col justify-between backdrop-blur-sm">
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center space-x-2">
                  <span class="text-2xl">${item.flag}</span>
                  <h4 class="font-bold text-white text-base">${item.name}</h4>
                </div>
                ${item.schengen_access ? '<span class="text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded">🇪🇺 Schengen</span>' : ''}
              </div>
              <p class="text-xs text-slate-300 line-clamp-1 mb-4">${item.visa_name}</p>

              <div class="grid grid-cols-2 gap-2 text-xs py-3 border-y border-white/10 mb-4 font-mono">
                <div>
                  <span class="text-slate-400 text-[10px] block">Req. Income</span>
                  <span class="font-bold text-emerald-400">$${item.min_monthly_income_usd.toLocaleString()}/mo</span>
                </div>
                <div>
                  <span class="text-slate-400 text-[10px] block">Nomad Tax</span>
                  <span class="font-bold text-blue-300">${item.tax_rate_percent}%</span>
                </div>
                <div>
                  <span class="text-slate-400 text-[10px] block">Avg. Cost</span>
                  <span class="text-slate-200">$${item.avg_monthly_living_cost_usd}/mo</span>
                </div>
                <div>
                  <span class="text-slate-400 text-[10px] block">Max Stay</span>
                  <span class="text-slate-200">${item.max_stay_months} mos</span>
                </div>
              </div>
            </div>

            <a 
              href="/visa/${item.id}" 
              class="w-full text-center py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-bold transition flex items-center justify-center space-x-1"
            >
              <span>View Full Checklist</span>
              <span>→</span>
            </a>
          </div>
        `).join('');
      }

      incomeSlider.addEventListener('input', updateMatcher);
      regionSelect.addEventListener('change', updateMatcher);
      taxSelect.addEventListener('change', updateMatcher);

      updateMatcher();

      // Quick filter tabs for Active Nomad Visa Programs directory
      const filterTabs = document.querySelectorAll('.filter-tab');
      const cards = document.querySelectorAll('.country-card');

      filterTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const filter = tab.getAttribute('data-filter');

          // Update active tab style
          filterTabs.forEach(t => {
            t.className = 'filter-tab px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:border-slate-400 cursor-pointer transition';
          });
          tab.className = 'filter-tab px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-semibold cursor-pointer shadow-sm transition';

          // Filter cards
          cards.forEach(card => {
            const region = card.getAttribute('data-region');
            const income = parseFloat(card.getAttribute('data-income') || '0');
            const tax = parseFloat(card.getAttribute('data-tax') || '0');

            let show = false;
            if (filter === 'all') {
              show = true;
            } else if (filter === 'europe') {
              show = region === 'Europe';
            } else if (filter === 'low-income') {
              show = income < 3000;
            } else if (filter === 'zero-tax') {
              show = tax === 0;
            }

            if (show) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initQuiz);
    } else {
      initQuiz();
    }
  </script>
</Layout>
