---
import Layout from '../layouts/Layout.astro';
import countries from '../data/countries.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Global Digital Nomad Visas Database 2026",
  "description": "Comprehensive structured database of digital nomad visas, income thresholds, taxes, Schengen privileges, and duration for 80+ countries.",
  "keywords": ["digital nomad visa", "remote work visa", "no tax countries", "schengen digital nomad", "visa income requirements"],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": {
    "@type": "Organization",
    "name": "NomadMatrix"
  }
};
---

<Layout title="Digital Nomad Visas 2026: Compare Income, Taxes & Requirements" schema={schema}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/60 to-white pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-100/70 border border-blue-200 text-blue-800 text-xs sm:text-sm font-semibold mb-6">
        <span>✨ 100% Free & Open Source of Truth for Remote Relocation</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        Find Your Next Haven: <br />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
          Compare Global Nomad Visas & Taxes
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        No hidden paywalls. Compare minimum monthly income, tax breaks, processing speeds, and stay durations across official immigration programs.
      </p>

      <!-- Quick Metrics Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto">
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-blue-600">{countries.length}+</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Verified Programs</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-emerald-600">0% - 24%</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Tax Regimes</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-purple-600">$0 - $5.5k</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Income Spans</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-2xl font-black text-amber-600">Weekly</div>
          <div class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-1">Laws Verified</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Responsive Ad Slot (Top Placement) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-8">
    <div class="bg-slate-100/80 border border-dashed border-slate-300 rounded-xl py-4 px-6 text-center text-xs text-slate-400">
      <span class="font-semibold uppercase tracking-wider">Advertisement / Sponsored Placement</span>
      <div class="mt-2 text-sm text-slate-700 font-medium">
        🛡️ Working remotely abroad? <a href="#" class="text-blue-600 underline font-semibold">SafetyWing Nomad Insurance covers you in 180+ countries for $45/4 weeks →</a>
      </div>
    </div>
  </div>

  <!-- Main Directory Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-slate-200">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Active Nomad Visa Programs</h2>
        <p class="text-sm text-slate-500 mt-1">Click any country for complete requirements, checklist, tax details and official application links.</p>
      </div>

      <!-- Quick Filter Tags -->
      <div class="flex flex-wrap gap-2 mt-4 sm:mt-0">
        <span class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-semibold cursor-pointer shadow-sm">All ({countries.length})</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:border-slate-400 cursor-pointer transition">Europe ({countries.filter(c => c.region === 'Europe').length})</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:border-slate-400 cursor-pointer transition">Low Income (&lt;$3,000)</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:border-slate-400 cursor-pointer transition">0% Tax Havens</span>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {countries.map((item) => (
        <a 
          href={`/visa/${item.id}`} 
          class="group bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-xl hover:border-blue-400 transition-all duration-200 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center space-x-3">
                <span class="text-3xl">{item.flag}</span>
                <div>
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition flex items-center gap-1.5">
                    {item.name}
                  </h3>
                  <span class="text-xs text-slate-400 font-medium">{item.region}</span>
                </div>
              </div>

              {item.schengen_access && (
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                  🇪🇺 Schengen
                </span>
              )}
            </div>

            <p class="text-xs text-slate-500 mb-5 font-medium line-clamp-1">
              {item.visa_name}
            </p>

            <!-- Metrics Matrix -->
            <div class="grid grid-cols-2 gap-3 py-3 border-y border-slate-100 mb-4 text-xs">
              <div>
                <span class="text-slate-400 block text-[11px]">Min. Income / mo</span>
                <span class="font-extrabold text-slate-900 text-sm">
                  {item.min_monthly_income_usd === 0 ? "Savings Only" : `$${item.min_monthly_income_usd.toLocaleString()}/mo`}
                </span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Stay Duration</span>
                <span class="font-extrabold text-slate-900 text-sm">
                  {item.duration_months} mo ({item.max_stay_years}y max)
                </span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Living Cost (avg)</span>
                <span class="font-semibold text-slate-800">
                  ${item.avg_monthly_living_cost_usd}/mo
                </span>
              </div>
              <div>
                <span class="text-slate-400 block text-[11px]">Nomad Tax Rate</span>
                <span class={`font-semibold ${item.tax_rate_percent === 0 ? 'text-emerald-600 font-bold' : 'text-slate-800'}`}>
                  {item.tax_rate_percent}% {item.tax_rate_percent === 0 && '⚡ Zero Tax'}
                </span>
              </div>
            </div>

            <div class="text-xs text-slate-500 space-y-1 mb-4">
              <span class="text-[11px] text-slate-400 font-medium block">Key Hotspots:</span>
              <div class="flex flex-wrap gap-1.5">
                {item.top_cities.map((city) => (
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[11px]">
                    {city}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-600 group-hover:translate-x-1 transition-transform">
            <span>View Full Requirements & Guides</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Side-by-Side Comparison Section (pSEO Powerhouse) -->
  <section id="compare-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl">
      <div class="max-w-3xl mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Head-to-Head Comparisons</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mt-2">
          Compare Visas Side-by-Side
        </h2>
        <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
          Torn between two destinations? See direct parameter-by-parameter matchups of tax rates, income limits, and living costs.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/compare/spain-vs-portugal" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇪🇸 Spain vs 🇵🇹 Portugal</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Europe's top two visas compared: Beckham Law vs NHR replacement.</p>
        </a>

        <a href="/compare/thailand-vs-japan" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇹🇭 Thailand vs 🇯🇵 Japan</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Asia comparison: 5-year DTV visa vs 6-month Japan Nomad visa.</p>
        </a>

        <a href="/compare/croatia-vs-greece" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇭🇷 Croatia vs 🇬🇷 Greece</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Mediterranean lifestyle: 0% Croatian tax vs Greek 50% deduction.</p>
        </a>

        <a href="/compare/costa_rica-vs-mexico" class="bg-white/10 hover:bg-white/20 border border-white/15 p-4 rounded-xl transition backdrop-blur-sm group">
          <div class="text-lg font-bold flex items-center justify-between">
            <span>🇨🇷 Costa Rica vs 🇲🇽 Mexico</span>
            <span class="text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-300 mt-2">Latin America battle: Complete tax exemption vs Temporary Residency.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Pro Kit Monetization Section ($14.99) -->
  <section id="pro-kit" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-white border-2 border-indigo-600/30 rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-indigo-500/10 rounded-full blur-2xl"></div>

      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold uppercase tracking-wider mb-4">
          ★ NomadMatrix Pro Toolkit
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Everything You Need to Apply with Confidence
        </h2>
        <p class="text-slate-600 mt-3 text-base leading-relaxed">
          Skip $2,000 legal consulting fees. Get the exact, battle-tested templates, step-by-step checklists, and interactive tax simulators.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8 text-sm text-slate-700">
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>Remote Employer Attestation Letter</strong> (Apostille-ready lawyer verified template)</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>183-Day Tax Residence Calculator</strong> (Excel & Web interactive simulator)</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>Document Checklist for 25+ Countries</strong> (Translations, Criminal records, Sworn affidavits)</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-emerald-500 font-bold text-lg">✓</span>
            <span><strong>Consulate & Embassy Submission Dossier</strong> (Folder structure & file naming guides)</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-baseline sm:items-center space-y-4 sm:space-y-0 sm:space-x-6">
          <div class="flex items-baseline space-x-2">
            <span class="text-4xl font-black text-slate-900">$14.99</span>
            <span class="text-sm text-slate-400 line-through">$49.00</span>
            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">Save 70% Today</span>
          </div>

          <!-- Gumroad Checkout Trigger -->
          <a 
            href="https://2683573618956.gumroad.com/l/byryi" 
            target="_blank"
            class="px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/25 hover:from-blue-700 hover:to-indigo-700 transition hover:scale-[1.02] active:scale-[0.98] text-center"
          >
            Instant Download Nomad Pro Kit →
          </a>
        </div>
        <p class="text-xs text-slate-400 mt-3">🔒 30-day no-questions-asked refund guarantee. Processed via Gumroad (Credit Card / PayPal / Apple Pay).</p>
      </div>
    </div>
  </section>
</Layout>
