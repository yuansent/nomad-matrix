---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  schema?: Record<string, any>;
}

const { 
  title, 
  description = "Compare Digital Nomad Visas worldwide: income requirements, taxes, stay duration, processing times, and cost of living for remote workers in 2026.",
  schema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://nomadmatrix.com");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | NomadMatrix</title>
    <meta name="title" content={`${title} | NomadMatrix`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | NomadMatrix`} />
    <meta property="og:description" content={description} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | NomadMatrix`} />
    <meta property="twitter:description" content={description} />

    <!-- Structured Data (Schema.org) for GEO & AI Search -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans antialiased selection:bg-blue-500 selection:text-white">
    <!-- Top Announcement / Affiliate Banner -->
    <div class="bg-gradient-to-r from-blue-700 via-indigo-700 to-purple-700 text-white text-xs sm:text-sm py-2 px-4 text-center font-medium shadow-inner">
      <span>🚀 2026 Digital Nomad Visa Index is live. Updated weekly with verified immigration sources.</span>
      <a href="https://2683573618956.gumroad.com/l/byryi" target="_blank" rel="noopener" class="ml-2 underline font-bold hover:text-amber-200 transition">Get the All-in-One Checklist →</a>
    </div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <a href="/" class="flex items-center space-x-2">
            <span class="text-2xl">🌐</span>
            <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
              NomadMatrix
            </span>
          </a>
          <span class="hidden md:inline-block px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-blue-700 bg-blue-50 rounded-full border border-blue-200">
            Source of Truth
          </span>
        </div>

        <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-blue-600 transition">Visas Directory</a>
          <a href="/#compare-section" class="hover:text-blue-600 transition">Compare Countries</a>
          <a href="/#tax-guide" class="hover:text-blue-600 transition">Tax & Savings</a>
          <a href="https://2683573618956.gumroad.com/l/byryi" target="_blank" rel="noopener" class="text-indigo-600 hover:text-indigo-700 font-semibold">Pro Checklist Kit ($14.99)</a>
        </nav>

        <div class="flex items-center space-x-3">
          <a 
            href="https://2683573618956.gumroad.com/l/byryi" 
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm shadow-blue-500/20 transition-all hover:scale-[1.02] active:scale-[0.98]">
            Get Checklist Kit
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer (Crucial for AdSense & Trust) -->
    <footer class="bg-white border-t border-slate-200 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="space-y-3">
            <div class="flex items-center space-x-2">
              <span class="text-xl">🌐</span>
              <span class="text-lg font-bold text-slate-900">NomadMatrix</span>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed">
              The independent, data-driven index for remote workers, nomads, and global tech workers comparing legal stay, taxes, and residency paths.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-slate-900 tracking-wider uppercase mb-3">Popular Countries</h4>
            <ul class="space-y-2 text-sm text-slate-600">
              <li><a href="/visa/spain" class="hover:text-blue-600">Spain Nomad Visa</a></li>
              <li><a href="/visa/portugal" class="hover:text-blue-600">Portugal D8 Visa</a></li>
              <li><a href="/visa/thailand" class="hover:text-blue-600">Thailand DTV Visa</a></li>
              <li><a href="/visa/japan" class="hover:text-blue-600">Japan Nomad Visa</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-sm font-bold text-slate-900 tracking-wider uppercase mb-3">Top Comparisons</h4>
            <ul class="space-y-2 text-sm text-slate-600">
              <li><a href="/compare/spain-vs-portugal" class="hover:text-blue-600">Spain vs Portugal</a></li>
              <li><a href="/compare/thailand-vs-japan" class="hover:text-blue-600">Thailand vs Japan</a></li>
              <li><a href="/compare/croatia-vs-greece" class="hover:text-blue-600">Croatia vs Greece</a></li>
              <li><a href="/compare/costa_rica-vs-mexico" class="hover:text-blue-600">Costa Rica vs Mexico</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-sm font-bold text-slate-900 tracking-wider uppercase mb-3">Legal & Disclaimers</h4>
            <p class="text-xs text-slate-400 mb-2 leading-relaxed">
              Disclaimer: NomadMatrix provides informational data compiled from official immigration portals and ministries. We are not an immigration law firm.
            </p>
            <div class="flex space-x-3 text-xs text-slate-500">
              <a href="/privacy" class="underline hover:text-slate-700">Privacy Policy</a>
              <span>•</span>
              <a href="/terms" class="underline hover:text-slate-700">Terms of Service</a>
              <span>•</span>
              <a href="/disclosure" class="underline hover:text-slate-700">Affiliate Disclosure</a>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400">
          <p>© 2026 NomadMatrix. Built for global builders & remote workers.</p>
          <p class="mt-2 sm:mt-0">Verified Schema.org & GEO-ready index.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
